{
  "uid": "mlops-hw11",
  "title": "ДЗ 11 · Kubernetes под нагрузкой",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "TTFC по Pod",
      "datasource": {
        "type": "prometheus",
        "uid": "hw11-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (pod, le)(rate(hw11_ttfc_seconds_bucket[30s])))",
          "legendFormat": "{{pod}} p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (pod, le)(rate(hw11_ttfc_seconds_bucket[30s])))",
          "legendFormat": "{{pod}} p50",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Полный ответ по Pod",
      "datasource": {
        "type": "prometheus",
        "uid": "hw11-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (pod, le)(rate(hw11_total_seconds_bucket[30s])))",
          "legendFormat": "{{pod}} p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Занятые слоты и очередь",
      "datasource": {
        "type": "prometheus",
        "uid": "hw11-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hw11_running",
          "legendFormat": "{{pod}} running",
          "refId": "A"
        },
        {
          "expr": "hw11_waiting",
          "legendFormat": "{{pod}} waiting",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Успешные ответы",
      "datasource": {
        "type": "prometheus",
        "uid": "hw11-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(hw11_requests_total{outcome=\"ok\"}[30s]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Отказы и обрывы",
      "datasource": {
        "type": "prometheus",
        "uid": "hw11-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(hw11_requests_total{outcome!=\"ok\"}[30s]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU по Pod",
      "datasource": {
        "type": "prometheus",
        "uid": "hw11-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{container=\"api\"}[30s]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "RAM по Pod",
      "datasource": {
        "type": "prometheus",
        "uid": "hw11-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{container=\"api\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Ready реплики",
      "datasource": {
        "type": "prometheus",
        "uid": "hw11-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_ready{deployment=\"hw11-api\",namespace=\"hw11\"}",
          "legendFormat": "Ready",
          "refId": "A"
        }
      ]
    }
  ]
}
